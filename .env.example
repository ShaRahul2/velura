# Environment

DATABASE_URL="postgresql://user:pass@localhost:5432/velura"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth admin desk (env operator)
AUTH_URL="http://localhost:3000"
AUTH_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Clerk customer SSO (Google + email)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""
# Alias accepted by the webhook route:
# CLERK_WEBHOOK_SIGNING_SECRET=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/account"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/account"

# Media / payments (optional locally)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
# Razorpay Dashboard → Webhooks. Without this, every webhook is rejected and
# online orders can stay stuck as "pending" if the buyer drops off before redirect.
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Rate limiting (optional). Without these, the limiter falls back to a
# per-process map, which is ineffective on serverless / multi-instance hosts.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Error monitoring (optional). Sentry is a no-op unless a DSN is present.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
# SENTRY_TRACES_SAMPLE_RATE="0.1"

# Order email (optional). Leave RESEND_API_KEY empty to skip sending.
RESEND_API_KEY=""
ORDER_FROM_EMAIL="VELURA <hello@thevelura.in>"

# ── Shipping — Shiprocket ────────────────────────────────────────────────────
# API user (Settings → API → Create an API user). Without these the shipping
# layer falls back to the "manual" provider (admin types the AWB by hand).
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
# Nickname of the pickup address configured in Shiprocket (default "Primary").
SHIPROCKET_PICKUP_LOCATION="Primary"
# Optional overrides
# SHIPROCKET_BASE_URL="https://apiv2.shiprocket.in/v1/external"
# SHIPROCKET_CHANNEL_ID=""
# Settings → API → Webhooks: set a token here and paste the same value below.
SHIPROCKET_WEBHOOK_TOKEN=""

# Parcel defaults for a bra + box. Weight is per unit; box is L x B x H in cm.
SHIPPING_DEFAULT_WEIGHT_KG="0.3"
SHIPPING_BOX_CM="15x12x5"

# Cron secret for /api/shipping/sync (Vercel Cron sends it as a Bearer token).
CRON_SECRET=""

# ── Shipping notifications — WhatsApp (Meta Cloud API) ───────────────────────
# Inert unless both are set. Business-initiated messages need approved templates.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_GRAPH_VERSION="v21.0"
# WHATSAPP_TEMPLATE_LANG="en"
WHATSAPP_TEMPLATE_PLACED=""
WHATSAPP_TEMPLATE_SHIPPED=""
WHATSAPP_TEMPLATE_OUT_FOR_DELIVERY=""
WHATSAPP_TEMPLATE_DELIVERED=""
WHATSAPP_TEMPLATE_CANCELLED=""
WHATSAPP_TEMPLATE_RETURNED=""
