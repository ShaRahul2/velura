# Environment

DATABASE_URL="postgresql://user:pass@localhost:5432/velura"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth admin desk (env operator)
AUTH_URL="http://localhost:3000"
AUTH_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Clerk customer SSO (Google + email)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""
# Alias accepted by the webhook route:
# CLERK_WEBHOOK_SIGNING_SECRET=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/account"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/account"

# Media / payments (optional locally)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
# Razorpay Dashboard → Webhooks. Without this, every webhook is rejected and
# online orders can stay stuck as "pending" if the buyer drops off before redirect.
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Rate limiting (optional). Without these, the limiter falls back to a
# per-process map, which is ineffective on serverless / multi-instance hosts.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Error monitoring (optional). Sentry is a no-op unless a DSN is present.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
# SENTRY_TRACES_SAMPLE_RATE="0.1"

# Order email (optional). Leave RESEND_API_KEY empty to skip sending.
RESEND_API_KEY=""
ORDER_FROM_EMAIL="VELURA <hello@thevelura.in>"
