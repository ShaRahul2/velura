generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum ProductCategory {
  everyday
  pushup
  lace
  sports
  seamless
  plus
  bridal
}

enum BadgeType {
  Bestseller
  New
  Sale
  Premium
  ComfortFit
}

enum SupportLevel {
  Light
  Medium
  High
}

enum ImageType {
  front
  back
  lifestyle
  detail
}

// ── Category ─────────────────────────────────────────────────────────────────
// One row per product category. Slug is the canonical identifier used in URLs
// and filters. Adding a new category is a data change, not a schema migration.

model Category {
  id          Int             @id @default(autoincrement())
  slug        ProductCategory @unique
  label       String
  description String?
  imageUrl    String?
  sortOrder   Int             @default(0)
  products    Product[]
}

// ── Product ──────────────────────────────────────────────────────────────────
// Core product record. `rating` and `reviewCount` are denormalised aggregates
// recomputed whenever a Review is created/deleted (a background job or trigger).
// `sizes` is a display-only label — not queryable by individual size.

model Product {
  id          Int            @id @default(autoincrement())
  name        String
  story       String
  sub         String
  price       Int
  oldPrice    Int?
  emoji       String
  badge       BadgeType?
  categoryId  Int
  category    Category       @relation(fields: [categoryId], references: [id])
  rating      Float
  reviewCount Int
  fabric      String
  support     SupportLevel
  sizes       String
  isActive    Boolean        @default(true)
  images      ProductImage[]
  reviews     Review[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([categoryId])
  @@index([support])
  @@index([price])
  @@index([rating])
}

// ── ProductImage ──────────────────────────────────────────────────────────────
// Each image is its own row. `position` controls display order (0 = hero).
// `type` allows the gallery to distinguish front/back/lifestyle shots.
// `blurDataURL` stores a tiny base64 placeholder for the primary image.

model ProductImage {
  id          Int       @id @default(autoincrement())
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  key         String?
  alt         String?
  position    Int       @default(0)
  type        ImageType @default(front)
  isPrimary   Boolean   @default(false)
  blurDataURL String?

  @@index([productId, position])
}

// ── Review ────────────────────────────────────────────────────────────────────
// Individual customer review. `rating` is 1–5. The product's `rating` /
// `reviewCount` fields are denormalised summaries of this table.

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  body      String?
  author    String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

// ── Order ─────────────────────────────────────────────────────────────────────
// One row per customer order. Address fields are denormalised (no reuse needed).
// Totals are recalculated server-side on creation — client values are ignored.

enum OrderStatus {
  pending
  confirmed
  shipped
  delivered
  returned
  cancelled
}

enum PaymentMethod {
  upi
  card
  netbanking
  cod
}

enum PaymentStatus {
  unpaid
  pending
  paid
  failed
  refunded
}

enum ProfileRole {
  customer
  manager
  admin
}

// ── Profile ───────────────────────────────────────────────────────────────────
// 1:1 with Clerk `userId`. Role is never accepted from the client — only the
// Clerk webhook (publicMetadata.role), SQL seed, or an admin-only API.

model Profile {
  id        String      @id
  email     String
  fullName  String?
  phone     String?
  role      ProfileRole @default(customer)
  avatarUrl String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  addresses Address[]
  cart      Cart?
  wishlist  WishlistItem[]
  orders    Order[]

  @@index([email])
  @@index([role])
}

model Address {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label      String   @default("Home")
  firstName  String   @default("")
  lastName   String   @default("")
  phone      String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("IN")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([profileId])
}

model Cart {
  id        String     @id @default(cuid())
  profileId String     @unique
  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId  Int?
  variant    Json
  variantKey String
  quantity   Int      @default(1)
  snapshot   Json
  createdAt  DateTime @default(now())

  @@unique([cartId, variantKey])
  @@index([cartId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  productId Int
  createdAt DateTime @default(now())

  @@unique([profileId, productId])
  @@index([profileId])
}

model Order {
  id            String        @id
  status        OrderStatus   @default(pending)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(unpaid)
  couponCode    String?

  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  paidAt            DateTime?
  paymentDetails    Json?
  carrier           String?
  trackingNumber    String?
  placedNotifiedAt  DateTime?

  // Totals — all in INR paise-less integers
  subtotal      Int
  shipping      Int
  discount      Int           @default(0)
  total         Int

  // Shipping address (denormalised)
  firstName     String
  lastName      String
  email         String
  phone         String
  addressLine   String
  city          String
  state         String
  pinCode       String
  placeId       String?
  lat           Float?
  lng           Float?
  shippingSnapshot Json?

  profileId     String?
  profile       Profile?      @relation(fields: [profileId], references: [id], onDelete: SetNull)

  items         OrderItem[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([email])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([profileId])
}

// ── OrderItem ─────────────────────────────────────────────────────────────────
// One row per line in an order. `productId` is null for custom bra items.
// `priceAtOrder` locks the price at the time of purchase.

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    Int?
  name         String
  size         String
  qty          Int
  priceAtOrder Int
  customSpec   Json?

  @@index([orderId])
}

// ── SavedDesign ───────────────────────────────────────────────────────────────
// Builder designs saved by the user. specHash deduplicates identical specs so
// the AI image is generated at most once per unique configuration.

model SavedDesign {
  id         String   @id @default(cuid())
  specHash   String   @unique
  specJson   Json
  previewUrl String?
  createdAt  DateTime @default(now())

  @@index([specHash])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
