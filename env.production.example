# Velura — production / hosted environment
# Paste these into Vercel → Project → Settings → Environment Variables
# (Production, and Preview if you use it). Then redeploy.
#
# Live origin (apex thevelura.in 308s here — use www, no trailing slash).
#
# Do NOT copy AUTH_URL or NEXT_PUBLIC_APP_URL from .env.local — those are localhost.

# ─── Site origin (must be the public https URL) ───────────────────────────────
NEXT_PUBLIC_APP_URL="https://www.thevelura.in"
AUTH_URL="https://www.thevelura.in"

# ─── Database (same Neon string as local is fine) ─────────────────────────────
DATABASE_URL=""

# ─── Cloudinary ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Razorpay ─────────────────────────────────────────────────────────────────
# You currently have rzp_test_ keys. Those work on the hosted site in Test Mode.
# Before taking real money, replace all three with rzp_live_ / live secret
# and set NEXT_PUBLIC_RAZORPAY_KEY_ID to the same live key id.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Dashboard → Webhooks → add:
#   https://www.thevelura.in/api/payments/webhook
# Then paste the webhook signing secret here.
RAZORPAY_WEBHOOK_SECRET=""

# ─── Google Maps (Places API New) ─────────────────────────────────────────────
# Restrict this key in Google Cloud to your production domain.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ─── Admin (NextAuth) ─────────────────────────────────────────────────────────
AUTH_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ─── Optional ─────────────────────────────────────────────────────────────────
# Atelier / search
XAI_API_KEY=""

# Builder AI preview (falls back to SVG if absent)
HF_TOKEN=""
# HF_MODEL="black-forest-labs/FLUX.1-schnell"
# REPLICATE_API_TOKEN=""
