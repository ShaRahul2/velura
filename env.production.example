# Velura — production / hosted environment
# Paste these into Vercel → Project → Settings → Environment Variables
# (Production, and Preview if you use it). Then redeploy.
#
# Live origin (apex thevelura.in 308s here — use www, no trailing slash).
#
# Do NOT copy AUTH_URL or NEXT_PUBLIC_APP_URL from .env.local — those are localhost.

# ─── Site origin (must be the public https URL) ───────────────────────────────
NEXT_PUBLIC_APP_URL="https://www.thevelura.in"
AUTH_URL="https://www.thevelura.in"

# ─── Database (same Neon string as local is fine) ─────────────────────────────
DATABASE_URL=""

# ─── Cloudinary ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Razorpay ─────────────────────────────────────────────────────────────────
# You currently have rzp_test_ keys. Those work on the hosted site in Test Mode.
# Before taking real money, replace all three with rzp_live_ / live secret
# and set NEXT_PUBLIC_RAZORPAY_KEY_ID to the same live key id.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Dashboard → Webhooks → add:
#   https://www.thevelura.in/api/payments/webhook
# Then paste the webhook signing secret here.
RAZORPAY_WEBHOOK_SECRET=""

# ─── Google Maps (Places API New) ─────────────────────────────────────────────
# Restrict this key in Google Cloud to your production domain.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ─── Clerk (customer SSO + staff roles) ───────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/account"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/account"

# Webhook: https://www.thevelura.in/api/webhooks/clerk  (user.created, user.updated)
# First admin: Clerk public metadata { "role": "admin" } or `npx tsx prisma/grant-admin.ts user_xxx admin`
# See docs/accounts.md

# ─── Admin (NextAuth credentials fallback) ────────────────────────────────────
AUTH_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ─── Order email (Resend). Leave empty to skip sending. ───────────────────────
# Verify www.thevelura.in in Resend, then:
# RESEND_API_KEY=""
# ORDER_FROM_EMAIL="VELURA <hello@thevelura.in>"

# ─── Rate limiting (strongly recommended in production) ───────────────────────
# Vercel is serverless: the in-process fallback limiter resets on every cold
# start and is not shared across instances. Create a free Upstash Redis DB and
# paste its REST URL + token so admin-login and checkout limits actually hold.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Error monitoring (recommended) ──────────────────────────────────────────
# Without a DSN the SDK is inert. SENTRY_AUTH_TOKEN enables source-map upload
# during the Vercel build.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
# SENTRY_TRACES_SAMPLE_RATE="0.1"

# ─── Shipping — Shiprocket ──────────────────────────────────────────────────
# Settings → API → Create an API user (a dedicated login, NOT your dashboard
# password). Absent → the admin falls back to entering AWBs by hand.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION="Primary"
# Settings → API → Webhooks → https://www.thevelura.in/api/shipping/webhook
# Set a token there and paste the identical value here.
SHIPROCKET_WEBHOOK_TOKEN=""
# Parcel defaults (per-unit weight kg; box L x B x H cm)
SHIPPING_DEFAULT_WEIGHT_KG="0.3"
SHIPPING_BOX_CM="15x12x5"
# Protects the /api/shipping/sync cron (Vercel Cron sends it as a Bearer token).
CRON_SECRET=""

# ─── Shipping notifications — WhatsApp (Meta Cloud API) ─────────────────────
# From the Meta WhatsApp Business app. Inert unless both are set. Each event
# needs an approved template; leave a template name blank to skip that event.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_TEMPLATE_LANG="en"
WHATSAPP_TEMPLATE_PLACED=""
WHATSAPP_TEMPLATE_SHIPPED=""
WHATSAPP_TEMPLATE_OUT_FOR_DELIVERY=""
WHATSAPP_TEMPLATE_DELIVERED=""
WHATSAPP_TEMPLATE_CANCELLED=""
WHATSAPP_TEMPLATE_RETURNED=""

# ─── Optional ─────────────────────────────────────────────────────────────────
# Atelier stylist + builder photoreal preview (Grok Imagine)
XAI_API_KEY=""
# XAI_IMAGE_MODEL="grok-imagine-image-2.0"

# Builder AI preview fallbacks if XAI_API_KEY is unset
HF_TOKEN=""
# HF_MODEL="black-forest-labs/FLUX.1-schnell"
# REPLICATE_API_TOKEN=""
